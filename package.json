{
  "name": "supabase-ai-production-lab",
  "private": true,
  "type": "module",
  "description": "Production Supabase for AI apps: RLS hardening, RAG in Postgres, Supabase + FastAPI",
  "scripts": {
    "db:start": "supabase start -x vector,logflare,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "demo:before": "node scripts/apply-sql.mjs ep1-rls-hardening/before/vulnerable.sql && node ep1-rls-hardening/exploit/run.mjs",
    "demo:after": "node scripts/apply-sql.mjs supabase/migrations/20261001000100_ep1_rls_policies.sql && node ep1-rls-hardening/exploit/run.mjs",
    "audit:db": "node scripts/apply-sql.mjs ep1-rls-hardening/audit.sql",
    "audit:keys": "node scripts/audit-client-keys.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "supabase": "^2.119.0"
  }
}
